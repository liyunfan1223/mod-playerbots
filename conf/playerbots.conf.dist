Playerbots.TeleToShattrathCityWeight = 1
Playerbots.TeleToDalaranWeight = 1

# How far randombots are teleported after death in yards
Playerbots.RandomBotTeleportDistance = 100

# How many levels below the lowest-level creature in a zone, can a bot be
# This will have no effect if Playerbots.EnableNewRpgStrategy is enabled
# Default: 1 (randombot will leave if they are more than 1 level lower)
Playerbots.RandomBotTeleLowerLevel = 1

# How many levels above the highest-level creature in a zone, can a bot be
# This will have no effect if Playerbots.EnableNewRpgStrategy is enabled
# Default: 3 (randombot will leave if they are more than 3 levels higher)
Playerbots.RandomBotTeleHigherLevel = 3

