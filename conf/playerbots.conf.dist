# THRESHOLDS
#

# Health/Mana levels
Playerbots.CriticalHealth = 25
Playerbots.LowHealth = 45
Playerbots.MediumHealth = 65
Playerbots.AlmostFullHealth = 85
Playerbots.LowMana = 15
Playerbots.MediumMana = 40
Playerbots.HighMana = 65

#
#
####################################################################################################

####################################################################################################
# QUESTS
#

# Bots pick their quest rewards
# yes = picks the most useful item, no = list all rewards, ask = pick useful item and lists if multiple
Playerbots.AutoPickReward = yes

# Sync quests with player (bots will complete quests the moment you hand them in and will not loot quest items.)
# Default: 1 (enabled)
Playerbots.SyncQuestWithPlayer = 1

# Bots will auto-complete quests for the player when handing in bots' quests
# Default: 0 (disabled)
Playerbots.SyncQuestForPlayer = 0

# Bots will drop obsolete quests
# Default: 1 (enabled)
Playerbots.DropObsoleteQuests = 1

#
#
####################################################################################################

####################################################################################################
# COMBAT
#

# Auto add dungeon/raid strategies when entering the instance if implemented
Playerbots.ApplyInstanceStrategies = 1

# Enable auto avoid aoe strategy
# Default: 1 (enabled)
Playerbots.AutoAvoidAoe = 1

# Only avoid aoe spells with a radius smaller than this value
Playerbots.MaxAoeAvoidRadius = 15.0

# A whitelist of aoe spell IDs that should not be avoided
Playerbots.AoeAvoidSpellWhitelist = 50759,57491,13810,29946

# Enable healer bot save mana strategy
# Default: 1 (enabled)
Playerbots.AutoSaveMana = 1

# Healer bot save mana threshold
# Default: 60 (60%)
Playerbots.SaveManaThreshold = 60

# Enable Paladin bots to use greater blessings, with the blessing used being based on the
# number of Paladins in the raid/group and the spec of the recipient. Priorities for each
# spec are hardcoded in GreaterBlessingActions.h.
# 0 = disabled
# 1 = enabled in raid groups only
# 2 = enabled in all groups
# Default: 1 (raid only)
Playerbots.AutoGreaterBlessings = 1

# Enable bots to use group reagent buffs: Gift of the Wild, Arcane Brilliance,
# Prayer of Fortitude, Prayer of Spirit, and Prayer of Shadow Protection.
# 0 = disabled
# 1 = enabled in raid groups only
# 2 = enabled in all groups
# Default: 2 (all groups)
Playerbots.AutoPartyBuffs = 2

# Bots tell the group when they attempt to use a reagent-based greater blessing or group buff
# but have to fall back to the single-target version because they are out of reagents.
# Default: 1 (enabled)
Playerbots.TellWhenMissingBuffReagents = 1

# Cooldown for the missing buff reagent message, in seconds.
# Default: 300 (5 minutes)
Playerbots.MissingBuffReagentMessageCooldown = 300

# When a ready check is issued out of combat, bots refresh missing/short buffs before reporting ready.
# A bot that still has buff work it can perform stays not-ready until the ready check ends; this
# includes missing reagents (the cast is attempted and fails). Uses the always-on "force rebuff"
# strategy: bots with strategy sets saved before this feature keep their saved set - reset their
# strategies or use "nc +force rebuff" to opt them in. The "rebuff" chat command starts the same
# buff pass without a ready check and works regardless of this setting.
# Default: 0 (disabled)
Playerbots.ForceRebuffOnReadyCheck = 0

# During a force-rebuff pass (ready check or the "rebuff" command), a buff is topped off (recast)
# once it drops more than this many seconds below its full duration, so buffs are refreshed toward
# maximum remaining time to last the fight. The effective margin never drops below the time the
# pass has already run, so small values are safe.
# Default: 60
Playerbots.ForceRebuffMarginSecs = 60

#
#
####################################################################################################

####################################################################################################
# CHEATS
#

# Enable/Disable maintenance command
# Learn all available spells and skills, assign talent points, refresh consumables, repair, enchant equipment, socket gems, etc.
# Applies if bot's level is above Playerbots.MinEnchantingBotLevel
# Default: 1 (enabled)
Playerbots.MaintenanceCommand = 1

# Enable/Disable specific maintenance command functionality for altbots
# Disable to prevent players from giving free bags, spells, skill levels, etc. to their altbots
# Default: 1 (enabled)
Playerbots.AltMaintenanceAmmo = 1
Playerbots.AltMaintenanceFood = 1
Playerbots.AltMaintenanceReagents = 1
Playerbots.AltMaintenanceConsumables = 1
Playerbots.AltMaintenancePotions = 1

Playerbots.AltMaintenanceBags = 1
Playerbots.AltMaintenanceMounts = 1
Playerbots.AltMaintenanceSkills = 1

# "Special Spells" consist of any spells listed in Playerbots.RandomBotSpellIds and Death Gate for Death Knights
Playerbots.AltMaintenanceClassSpells = 1
Playerbots.AltMaintenanceAvailableSpells = 1
Playerbots.AltMaintenanceSpecialSpells = 1
Playerbots.AltMaintenanceTalentTree = 1
Playerbots.AltMaintenanceGlyphs = 1
Playerbots.AltMaintenanceGemsEnchants = 1

Playerbots.AltMaintenancePet = 1
Playerbots.AltMaintenancePetTalents = 1

Playerbots.AltMaintenanceReputation = 1
Playerbots.AltMaintenanceAttunementQuests = 1
Playerbots.AltMaintenanceKeyring = 1

# Enable/Disable autogear command, which automatically upgrades bots' gear
# The quality is limited by AutoGearQualityLimit and AutoGearScoreLimit
# In-game syntax (the argument can only request at or below the configured limits):
#   autogear            - gear to the configured AutoGearQualityLimit / AutoGearScoreLimit
#   autogear green      - cap quality to uncommon (also: white/common, blue/rare, purple/epic,
#                         orange/legendary, artifact, heirloom)
#   autogear match      - match the commanding player's average item level, computed over the slots the
#                         player actually has filled so empty slots do not drag the target down
#   autogear 200        - target a specific item level (clamped to AutoGearScoreLimit when that is non-zero).
#                         Only positive whole numbers are accepted; negative or malformed values are rejected
#   autogear reset      - erase all equipped gear and regear from scratch (combinable: autogear reset green,
#                         autogear reset 200, autogear reset match)
#   autogear bis        - separate BiS command, see AutoGearBisCommand below
# Default: 1 (enabled)
Playerbots.AutoGearCommand = 1

# Enable/Disable autogear command on altbots
# Default: 1 (enabled)
Playerbots.AutoGearCommandAltBots = 1

# If 1 (enabled) chat command: autogear bis, gives bots BiS gear from the playerbots_bis_gear table
# whose item-level floor matches AutoGearScoreLimit (e.g. 290 = ICC, 245 = ToC,
# 125 = Kara, 78 = MC). See the AutoGearScoreLimit comment below for the full list.
# chat command: autogear bis x, (x must be positive integer) will give items based on value of x.
# If x is bigger than AutoGearScoreLimit, bis wont be given, if lower it will match x when giving items.
# Commands falls back to autogear when no tier matches or the table is empty for the bot's class/spec.
# Requires AutoGearQualityLimit = 4 and AutoGearCommand = 1.
# If AutoGearCommandAltBots = 1 it will be anbled for alt bots.
# Default: 0 (disabled)
Playerbots.AutoGearBisCommand = 0

# Equipment quality limitation for autogear command (1 = normal, 2 = uncommon, 3 = rare, 4 = epic, 5 = legendary)
# Default: 3 (rare)
Playerbots.AutoGearQualityLimit = 3

# Equipment item level (not gearscore) limitation for autogear command (0 = no limit)
# Classic
# Max iLVL Tier 1 = 66 | Tier 2 = 76 | Tier 2.5 = 88 | Tier 3 = 92
# Max iLVL Phase 1(MC, Ony, ZG) = 78 | Phase 2(BWL) = 83 | Phase 2.5(AQ40) = 88 | Phase 3(Naxx40) = 92
# TBC
# Max iLVL Tier 4 = 120 | Tier 5 = 133 | Tier 6 = 164
# Max iLVL Phase 1(Kara, Gruul, Mag) = 125 | Phase 2(SSC, TK, ZA) = 141 | Phase 3(Hyjal, BT) = 156 | Phase 4(Sunwell) = 164
# WotLK
# Max iLVL Tier 7(10/25) = 200/213 | Tier 8(10/25) = 225/232 | Tier 9(10/25) = 232/245 | Tier 10(10/25/HC) = 251/264/290
# Max iLVL Phase 1(Naxx) = 224 | Phase 2(Ulduar) = 245 | Phase 3(ToC) = 258 | Phase 4(ICC) = 290
# Default: 0 (no limit)
Playerbots.AutoGearScoreLimit = 0

# Enable/Disable cheats for bots
# "food" (bots eat or drink without using food or drinks from their inventory)
# "gold" (bots have infinite gold)
# "health" (bots immediately regenerate lost health)
# "mana" (bots have infinite mana)
# "power" (bots have infinite energy, rage, and runic power)
# "taxi" (bots may use all flight paths, though they will not actually learn them)
# "raid" (bots use certain cheats implemented into raid strategies)
# To use multiple cheats, separate them by commas below (e.g., to enable all, use "gold,health,mana,power,raid,taxi")
# Default: food, taxi, and raid are enabled
Playerbots.BotCheats = "food,taxi,raid"

# List of attunement quests (comma-separated list of quest IDs) that are automatically completed for all bots.
# While mod-playerbots does not restore removed attunement requirements, other mods, such as mod-individual-progression, may do so.
# This is meant to exclude bots from such requirements.
#
# Defaults:
# Caverns of Time - Part 1
# - 10279, To The Master's Lair
# - 10277, The Caverns of Time
# Caverns of Time - Part 2 (Escape from Durnholde Keep)
# - 10282, Old Hillsbrad
# - 10283, Taretha's Diversion
# - 10284, Escape from Durnholde
# - 10285, Return to Andormu
# Caverns of Time - Part 2 (The Black Morass)
# - 10296, The Black Morass
# - 10297, The Opening of the Dark Portal
# - 10298, Hero of the Brood
# Magister's Terrace
# - 11481, Crisis at the Sunwell
# - 11482, Duty Calls
# - 11488, Magisters' Terrace
# - 11490, The Scryer's Scryer
# - 11492, Hard to Kill
# Serpentshrine Cavern
# - 10901, The Cudgel of Kar'desh
# Tempest Keep: The Eye
# - 10888, Trial of the Naaru: Magtheridon
# Battle for Mount Hyjal (Hyjal Summit)
# - 10445, The Vials of Eternity
# Black Temple
# - 10985, A Distraction for Akama
Playerbots.AttunementQuests = 10279,10277,10282,10283,10284,10285,10296,10297,10298,11481,11482,11488,11490,11492,10901,10888,10445,10985

#
#
####################################################################################################

####################################################################################################
# FLIGHTPATH
#

# Min random delay before the 1st follower bot clicks the flight-master (ms)
Playerbots.BotTaxiDelayMinMs = 350

# Upper bound for the overall taxi delay window (ms) – larger spreads big raids
Playerbots.BotTaxiDelayMaxMs = 5000

# Fixed gap added per group-slot so bots never take off together (ms)
Playerbots.BotTaxiGapMs = 200

# Extra small randomness added to each gap so launches don’t look robotic (ms)
Playerbots.BotTaxiGapJitterMs = 100

#
#
####################################################################################################

####################################################################################################
# PROFESSIONS
#

# Percentage of randombots in each class bucket that receive a class-matching
# weighted profession combination. The remaining randombots use the weighted
# random sane-pair profession pool.
# Default: 30
Playerbots.ClassMatchingProfessionChance = 30

# Automatically adds the 'master fishing' strategy to bots that have the fishing skill when the bots master fishes.
# Default: 1 (Enabled)
Playerbots.EnableFishingWithMaster = 1

# Distance from itself (in yards) that a bot with a master will search for water to fish
Playerbots.FishingDistanceFromMaster = 10.0

# Distance from itself (in yards) that a bot without a master will search for water to fish
# Currently not relevant since masterless bots will not fish
Playerbots.FishingDistance = 40.0

# Distance from water (in yards) beyond which a bot will remove the 'master fishing' strategy
Playerbots.EndFishingWithMaster = 30.0

#
#
####################################################################################################

#######################################
#                                     #
# RANDOMBOT-SPECIFIC SETTINGS         #
#                                     #
#######################################

####################################################################################################
# GENERAL
#

# Enable/Disable randomly generated password for randombot accounts
Playerbots.RandomBotRandomPassword = 0

# Minimum and maximum levels for randombots
Playerbots.RandomBotMinLevel = 1
Playerbots.RandomBotMaxLevel = 80

# Sync max randombot level with max level of online players
# Default: 0 (disabled)
Playerbots.SyncLevelWithPlayers = 0

# Concentrate randombots teleporting into level-appropriate open-world zones that hold a real
# (non-GM) player. Falls back to normal teleporting behaviour when no player's zone matches.
# Best paired with Playerbots.SyncLevelWithPlayers.
# Default: 0 (disabled)
Playerbots.RandomBotConcentrateInPlayerZone = 0

# Mark many quests ≤ bot level as complete (slows down bot creation)
# Default: 0 (disabled)
Playerbots.PreQuests = 0

# Enable LFG for randombots
# Default: 1 (enabled)
Playerbots.RandomBotJoinLfg = 1

# Enable/Disable periodic online - offline of randombots to mimic the real-world scenario where not all players are online simultaneously
# When enabled, randombots are randomly selected to go online or offline periodically from a larger set
# Default: 0 (disabled, the set of online bots remains fixed)
Playerbots.EnablePeriodicOnlineOffline = 0

# Defines the ratio between the total number of randombots (including offline ones) and the number of randombots currently online (MaxRandomBots)
# This setting must greater than 1.0 and only applies when EnablePeriodicOnlineOffline
# Default: 2.0 (total number of bots is twice the number of MaxRandomBots)
Playerbots.PeriodicOnlineOfflineRatio = 2.0

# Percentage ratio of Alliance and Horde randombots
Playerbots.RandomBotAllianceRatio = 50
Playerbots.RandomBotHordeRatio = 50

# Disable logging in of death knight bots
Playerbots.DisableDeathKnightLogin = 0

# Enable simulated expansion limitation for talents and glyphs
# If enabled, limits talent trees to 6 rows plus the middle talent of the 7th row for bots until level 61
# and 8 rows plus the middle talent of the 9th row for bots from level 61 until level 71
# Default: 0 (disabled)
Playerbots.LimitTalentsExpansion = 0

# Configure randombot trading (0: Disabled, 1: Enabled, 2: Only Buy, 3: Only Sell)
# Default: 1 (enabled)
Playerbots.EnableRandomBotTrading = 1

# Configure message prefixes which will be excluded in analysis in trade action to open trade window
Playerbots.TradeActionExcludedPrefixes = "RPLL_H_,DBMv4,{звезда} Questie,{rt1} Questie"

# Allow bots to send mail. When disabled, bots will not mail items or money in
# response to chat commands ("send mail").
# Default: 1 (enabled)
Playerbots.BotSendMailEnabled = 1

#
#
####################################################################################################

####################################################################################################
# LEVELS
#

# Disable randombots being generated with a random level
# If disabled, every randombot starts on a specified level (but can still level up by killing mobs and questing)
Playerbots.DisableRandomLevels = 0

# Set randombots' starting level here if "Playerbots.DisableRandomLevels" is enabled
Playerbots.RandombotStartingLevel = 1

# Chance randombot has min level on first randomize
# Default: 0.1 (10%)
Playerbots.RandomBotMinLevelChance = 0.1

# Chance randombot has max level on first randomize
# Default 0.1 (10%)
Playerbots.RandomBotMaxLevelChance = 0.1

# Fix the level of randombots (they won't level up)
# Default: 0 (disabled)
Playerbots.RandomBotFixedLevel = 0

# Set RandomBotMaxLevel bots to RandomBotMinLevel
# Default: 0 (disabled)
Playerbots.DowngradeMaxLevelBot = 0

# Set XP rate for randombots (Default: 1.0)
# Server XP Rate * Playerbots.RandomBotXPRate
Playerbots.RandomBotXPRate = 1.0

#
#
####################################################################################################

####################################################################################################
# RANDOM BOT LEVEL MANAGEMENT (LEVEL BRACKETS + LEVEL RESET)
#
# Two independent, opt-in sub-features for managing random bot levels over time. Both pick up
# changed values on the standard ".reload config" GM command.
#
#   - Level Brackets: periodically redistributes random bots across configurable per-faction level
#     brackets, optionally weighting the distribution toward brackets that contain real (non-bot)
#     players. This complements Playerbots.DowngradeMaxLevelBot-style behavior: instead of a
#     one-shot downgrade, it continuously rebalances the whole random bot population across brackets
#     over time.
#
#   - Level Reset: when a random bot reaches a configured max level, resets it back down to a lower
#     level via a full PlayerbotFactory randomize, with an optional percent chance (optionally
#     scaled by level), an optional minimum played-time restriction, and an optional "skip" that
#     sends a bot straight to a different level as soon as it reaches a configured trigger level.
#
# NOTE: Level Reset overlaps with Playerbots.DowngradeMaxLevelBot, which downgrades a bot that is
#       already at RandomBotMaxLevel to RandomBotMinLevel the next time it is periodically
#       re-randomized. Level Reset instead acts immediately (or on a played-time timer) as soon as a
#       bot reaches the configured level, with its own chance/played-time controls. Do not normally
#       enable both Playerbots.DowngradeMaxLevelBot and Playerbots.ResetBotLevel.Enabled at the
#       same time.
#

##############################################
# Level Brackets
##############################################

# Enables the level brackets feature.
# Default: 0 (disabled)
Playerbots.LevelBrackets.Enabled = 0

# The frequency (in seconds) at which the bot level distribution check is performed.
# Default: 300
Playerbots.LevelBrackets.CheckFrequency = 300

# The frequency (in seconds) at which pending level resets are processed for safe bots and flagged
# bots that failed safety checks initially.
# Default: 15
Playerbots.LevelBrackets.CheckFlaggedFrequency = 15

# Maximum number of flagged bots to process per pending level change step.
# 0 = unlimited (process all flagged bots each step)
# Default: 5
Playerbots.LevelBrackets.FlaggedProcessLimit = 5

# When enabled, bots in a guild led by a real (non-bot) player are excluded from bot bracket
# calculations and will not be level changed or flagged. Backed by the shared PlayerbotGuildMgr
# guild cache (validated at startup and refreshed hourly), which also covers offline players; a
# guild counts as real when its leader is not a random-bot account.
# Default: 1 (enabled)
Playerbots.LevelBrackets.IgnoreGuildBotsWithRealPlayers = 1

# When enabled, bots that are members of arena teams are excluded from bot bracket calculations
# and will not be level changed or flagged. This prevents bots in arena teams from being changed,
# which would break team compositions.
# Default: 1 (enabled)
Playerbots.LevelBrackets.IgnoreArenaTeamBots = 1

# Ignore bots that are on real players' friends lists from any brackets.
# Default: 1 (enabled)
Playerbots.LevelBrackets.IgnoreFriendListed = 1

# Comma-separated list of bot names to exclude from all bracket checks. Names must match the
# character name exactly (character names are stored capitalized, e.g. "Thrall").
# Default: ""
Playerbots.LevelBrackets.ExcludeNames =

# The number of level brackets used for bot distribution. Both Alliance and Horde should have the
# same number of brackets defined below.
# Default: 9
#
# IMPORTANT: If you extend the number of brackets beyond 9, you must add configuration lines for
#            the additional bracket lines below (e.g. Range10, Range11, etc.) to both your
#            playerbots.conf and this playerbots.conf.dist. Ensure that the sum of the Pct values
#            for each faction remains 100.
Playerbots.LevelBrackets.NumRanges = 9

# Enables dynamic recalculation of bot distribution percentages based on the number of non-bot
# players present in each level bracket. This overrides any custom brackets in the conf.
# Default: 0 (disabled)
Playerbots.LevelBrackets.Dynamic.UseDynamicDistribution = 0

# Controls how much extra weight is given to brackets (level ranges) that contain real (non-bot)
# players, when dynamic distribution is enabled. The higher this value, the more bots move to the
# same level brackets where real players are found, but the effect is gentle, not extreme. A value
# of 0.0 means bots always distribute evenly across all brackets, regardless of where players are.
# The default value of 1.0 gives a mild, balanced effect. Raising this to 3.0, 5.0, or higher makes
# bots concentrate more in brackets with real players. The value is a multiplier (not a percent):
# 0.0 = no extra effect, 1.0 = minimal, 3.0 = stronger, 5.0 = strong but not extreme. Experiment
# based on your total bot count and real player counts to find a good number for your server. If
# you want a large congestion of bots in your level bracket for solo play, 10-15 is recommended.
# What to expect:
#   - With 1.0 (default): if 6/10 real players are in one bracket, that bracket gets about 12.77%
#     of bots. All-empty brackets get about 10.69% each.
#   - With 3.0: same scenario: bracket gets about 15.73% of bots. All-empty brackets: 9.93% each.
#   - With 5.0: bracket with 6/10 real players gets 18.31%. All-empty brackets: 9.28% each.
#   - If all real players are in one bracket and weight is 5.0, that bracket gets about 21.56% of
#     bots (others: 9.80% each).
#   - With 0.0: every bracket always gets the same number of bots (e.g., 11.11% each for 9
#     brackets).
# Formula (per bracket):
#   bracket_weight = 1.0 + (RealPlayerWeight x (1 / TotalRealPlayers) x log(1 + RealPlayersInBracket))
#   All bracket weights are normalized to total 100%.
# Default: 1.0
Playerbots.LevelBrackets.Dynamic.RealPlayerWeight = 1.0

# If enabled, both Alliance and Horde must have identical bracket definitions (same number, same
# level bounds). All real players (regardless of faction) influence the dynamic distribution for
# both factions.
# Default: 0 (disabled)
# NOTE: If the brackets do not match when enabled, SyncFactions is forcibly disabled for that
#       session and an error is logged; the server will not fail to start over this.
Playerbots.LevelBrackets.Dynamic.SyncFactions = 0

##############################################
# Alliance Level Brackets Configuration
##############################################
# The following settings define the level brackets for Alliance bots. For each bracket, specify:
#
#    Playerbots.LevelBrackets.Alliance.RangeX.Lower
#        Description: The lower bound (inclusive) of bracket X.
#
#    Playerbots.LevelBrackets.Alliance.RangeX.Upper
#        Description: The upper bound (inclusive) of bracket X.
#
#    Playerbots.LevelBrackets.Alliance.RangeX.Pct
#        Description: The desired percentage of Alliance bots that should fall into bracket X.
#
# EXAMPLE:
#   The default configuration below defines 9 brackets: Range1 covers levels 1-9, Range2 covers
#   levels 10-19, Range3 covers levels 20-29, and so on.
#
#   To customize or add a new bracket (for example, to isolate level 60 in its own bracket):
#       - Set Range7.Lower = 60 and Range7.Upper = 60, then adjust the Pct values for Range6 and
#         Range8 accordingly.
#
#   To add an extra bracket beyond the default 9:
#       1. Increase Playerbots.LevelBrackets.NumRanges to the desired number.
#       2. Add configuration lines for the new RangeX.Lower, RangeX.Upper, and RangeX.Pct.
#
# NOTE: The sum of all Pct values for the Alliance brackets must equal 100.
#
Playerbots.LevelBrackets.Alliance.Range1.Lower = 1
Playerbots.LevelBrackets.Alliance.Range1.Upper = 9
Playerbots.LevelBrackets.Alliance.Range1.Pct   = 12

Playerbots.LevelBrackets.Alliance.Range2.Lower = 10
Playerbots.LevelBrackets.Alliance.Range2.Upper = 19
Playerbots.LevelBrackets.Alliance.Range2.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range3.Lower = 20
Playerbots.LevelBrackets.Alliance.Range3.Upper = 29
Playerbots.LevelBrackets.Alliance.Range3.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range4.Lower = 30
Playerbots.LevelBrackets.Alliance.Range4.Upper = 39
Playerbots.LevelBrackets.Alliance.Range4.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range5.Lower = 40
Playerbots.LevelBrackets.Alliance.Range5.Upper = 49
Playerbots.LevelBrackets.Alliance.Range5.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range6.Lower = 50
Playerbots.LevelBrackets.Alliance.Range6.Upper = 59
Playerbots.LevelBrackets.Alliance.Range6.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range7.Lower = 60
Playerbots.LevelBrackets.Alliance.Range7.Upper = 69
Playerbots.LevelBrackets.Alliance.Range7.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range8.Lower = 70
Playerbots.LevelBrackets.Alliance.Range8.Upper = 79
Playerbots.LevelBrackets.Alliance.Range8.Pct   = 11

Playerbots.LevelBrackets.Alliance.Range9.Lower = 80
Playerbots.LevelBrackets.Alliance.Range9.Upper = 80
Playerbots.LevelBrackets.Alliance.Range9.Pct   = 11

##############################################
# Horde Level Brackets Configuration
##############################################
# The following settings define the level brackets for Horde bots. For each bracket, specify:
#
#    Playerbots.LevelBrackets.Horde.RangeX.Lower
#        Description: The lower bound (inclusive) of bracket X.
#
#    Playerbots.LevelBrackets.Horde.RangeX.Upper
#        Description: The upper bound (inclusive) of bracket X.
#
#    Playerbots.LevelBrackets.Horde.RangeX.Pct
#        Description: The desired percentage of Horde bots that should fall into bracket X.
#
# EXAMPLE:
#   The default configuration below defines 9 brackets: Range1 covers levels 1-9, Range2 covers
#   levels 10-19, Range3 covers levels 20-29, and so on.
#
#   To customize or add a new bracket (for example, to isolate level 70 in its own bracket):
#       - Set Range8.Lower = 70 and Range8.Upper = 70, then adjust the Pct values for the adjacent
#         ranges.
#
# NOTE: The sum of all Pct values for the Horde brackets must equal 100.
#
Playerbots.LevelBrackets.Horde.Range1.Lower = 1
Playerbots.LevelBrackets.Horde.Range1.Upper = 9
Playerbots.LevelBrackets.Horde.Range1.Pct   = 12

Playerbots.LevelBrackets.Horde.Range2.Lower = 10
Playerbots.LevelBrackets.Horde.Range2.Upper = 19
Playerbots.LevelBrackets.Horde.Range2.Pct   = 11

Playerbots.LevelBrackets.Horde.Range3.Lower = 20
Playerbots.LevelBrackets.Horde.Range3.Upper = 29
Playerbots.LevelBrackets.Horde.Range3.Pct   = 11

Playerbots.LevelBrackets.Horde.Range4.Lower = 30
Playerbots.LevelBrackets.Horde.Range4.Upper = 39
Playerbots.LevelBrackets.Horde.Range4.Pct   = 11

Playerbots.LevelBrackets.Horde.Range5.Lower = 40
Playerbots.LevelBrackets.Horde.Range5.Upper = 49
Playerbots.LevelBrackets.Horde.Range5.Pct   = 11

Playerbots.LevelBrackets.Horde.Range6.Lower = 50
Playerbots.LevelBrackets.Horde.Range6.Upper = 59
Playerbots.LevelBrackets.Horde.Range6.Pct   = 11

Playerbots.LevelBrackets.Horde.Range7.Lower = 60
Playerbots.LevelBrackets.Horde.Range7.Upper = 69
Playerbots.LevelBrackets.Horde.Range7.Pct   = 11

Playerbots.LevelBrackets.Horde.Range8.Lower = 70
Playerbots.LevelBrackets.Horde.Range8.Upper = 79
Playerbots.LevelBrackets.Horde.Range8.Pct   = 11

Playerbots.LevelBrackets.Horde.Range9.Lower = 80
