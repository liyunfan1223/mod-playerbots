#
#
####################################################################################################

####################################################################################################
# BATTLEGROUNDS & ARENAS & PVP
#

# Enable battlegrounds/arenas for randombots
Playerbots.RandomBotJoinBG = 1

# Enable auto-joining of battlegrounds - have bots start battlegrounds and arenas on their own
Playerbots.RandomBotAutoJoinBG = 0

# Required Configuration for RandomBotAutoJoinBG
#
# Known issue: When enabling many brackets in combination with multiple instances, it can lead to more
# instances created by bots than intended (over-queuing).
#
# This section controls the level brackets and automatic bot participation in battlegrounds and arenas.
#
# Brackets:
# - Specify the level ranges for bots to auto-join (bracket IDs are per-BG and start at 0 from each BG's minimum level):
#   - Warsong Gulch    (WS): 0=10-19, 1=20-29, 2=30-39, 3=40-49, 4=50-59, 5=60-69, 6=70-79, 7=80    (Default: 7)
#   - Arathi Basin     (AB): 0=20-29, 1=30-39, 2=40-49, 3=50-59, 4=60-69, 5=70-79, 6=80             (Default: 6)
#   - Alterac Valley   (AV): 0=51-60, 1=61-70, 2=71-79, 3=80                                        (Default: 3)
#   - Eye of the Storm (EY): 0=61-69, 1=70-79, 2=80                                                 (Default: 2)
#   - Isle of Conquest (IC): 0=71-79, 1=80                                                          (Default: 1)
# - Multiple BG brackets can be specified as a comma-separated list (e.g., "0,2,5"). Not applicable for Rated Arena.
#   - Rated Arena:           0=10-14, 1=15-19, 2=20-24, ..., 13=75-79, 14=80-84                     (Default: 14)
#
# Counts:
# - Specify the number of battles to auto-fill per bracket.
# - For battlegrounds, 'Count" is the number of battles per bracket. For example:
#   - RandomBotAutoJoinWSBrackets = 6,7
#   - RandomBotAutoJoinBGWSCount = 1
#   - These configs would create two battles, one for bracket 6 and one for bracket 7.
# - Ensure there are enough eligible bots to meet the specified counts.

# Battleground bracket range possibilities:
# Playerbots.RandomBotAutoJoinWSBrackets = 0,1,2,3,4,5,6,7
# Playerbots.RandomBotAutoJoinABBrackets = 0,1,2,3,4,5,6
# Playerbots.RandomBotAutoJoinAVBrackets = 0,1,2,3
# Playerbots.RandomBotAutoJoinEYBrackets = 0,1,2
# Playerbots.RandomBotAutoJoinICBrackets = 0,1
Playerbots.RandomBotAutoJoinWSBrackets = 7
Playerbots.RandomBotAutoJoinABBrackets = 6
Playerbots.RandomBotAutoJoinAVBrackets = 3
Playerbots.RandomBotAutoJoinEYBrackets = 2
Playerbots.RandomBotAutoJoinICBrackets = 1

# Battlegrounds battles count (per bracket):
Playerbots.RandomBotAutoJoinBGWSCount = 1
Playerbots.RandomBotAutoJoinBGABCount = 1
Playerbots.RandomBotAutoJoinBGAVCount = 0
Playerbots.RandomBotAutoJoinBGEYCount = 1
Playerbots.RandomBotAutoJoinBGICCount = 0

# Arena bracket (single bracket only):
# Custom code changes are required for lower-level arena brackets to function properly.
Playerbots.RandomBotAutoJoinArenaBracket = 14

# Arena battles count:
Playerbots.RandomBotAutoJoinBGRatedArena2v2Count = 0
Playerbots.RandomBotAutoJoinBGRatedArena3v3Count = 0
Playerbots.RandomBotAutoJoinBGRatedArena5v5Count = 0

# Randombot arena team count
# Teams are created when bots are initialized on server restart.
# You may need to first delete all arena teams, then reinitialize bots.
# Warning: Reinitializing bots completely resets them (command in game: .playerbots rndbot init)
# Bots only join one arena team to avoid queueing issues. Take that into account when increasing count.
# Default: 2v2: 10 (20 Bots), 3v3: 10 (30 bots), 5v5: 5 (25 bots)
Playerbots.RandomBotArenaTeam2v2Count = 10
Playerbots.RandomBotArenaTeam3v3Count = 10
Playerbots.RandomBotArenaTeam5v5Count = 5

# Arena rating is randomized on team creation.
# Default: Max: 2000, Min: 1000
Playerbots.RandomBotArenaTeamMaxRating = 2000
Playerbots.RandomBotArenaTeamMinRating = 1000

# Delete all randombot (and any addclass bot) arena teams on startup. While enabled,
# no new randombot arena teams are created or joined. Set back to 0 and restart the
# server to resume normal randombot arena team assignment.
Playerbots.DeleteRandomBotArenaTeams = 0

# PvP Restricted Zones (bots will not initiate PvP or defend themselves if attacked)
Playerbots.PvpProhibitedZoneIds = "2255,656,2361,2362,2363,976,35,2268,3425,392,541,1446,3828,3712,3738,3565,3539,3623,4152,3988,4658,4284,4418,4436,4275,4323,4395,3703,4298,3951"

# PvP Restricted Areas (bots will not initiate PvP or defend themselves if attacked)
Playerbots.PvpProhibitedAreaIds = "976,35,392,2268,4161,4010,4317,4312,3649,3887,3958,3724,4080,3938,3754,3786,3973,4085,4086,4087,4088,251"

# Improve reaction speeds in battlegrounds and arenas (may cause lag)
Playerbots.FastReactInBG = 1

#
#
####################################################################################################

####################################################################################################
# RANDOMBOT TIMING AND BEHAVIOR
#

# How often (in seconds) the randombot manager runs its main update loop
# Default: 20
Playerbots.RandomBotUpdateInterval = 20

# Minimum and maximum seconds before the manager re-evaluates and adjusts total randombot count
# Defaults: 1800 (min), 7200 (max)
Playerbots.RandomBotCountChangeMinInterval = 1800
Playerbots.RandomBotCountChangeMaxInterval = 7200

# Minimum and maximum seconds a randombot will stay online before logging out
# Defaults: 600 (min), 28800 (max)
Playerbots.MinRandomBotInWorldTime = 600
Playerbots.MaxRandomBotInWorldTime = 28800

# Some aspects of randombots are periodically randomized while they are logged in and idle,
# including their inventories and, if EquipAndSpecPersistence is disabled, their equipment and specs.
# This config sets the minimum and maximum seconds between such randomization events.
# Defaults: 7200 (min - 2 hours), 1209600 (max - 14 days)
Playerbots.MinRandomBotRandomizeTime = 7200
Playerbots.MaxRandomBotRandomizeTime = 1209600

# Number of bots processed (login, logout, update) per manager update cycle
# Default: 60
Playerbots.RandomBotsPerInterval = 60

# Interval (in seconds) between periodic random bot statistics dumps in the log
# (online count, level/race/class distribution, roles, status). Set to 0 to disable.
# Default: 300
Playerbots.RandomBotPrintStatsInterval = 300

# Minimum and maximum seconds after death before a bot revives
# Defaults: 60 (min), 300 (max)
Playerbots.MinRandomBotReviveTime = 60
Playerbots.MaxRandomBotReviveTime = 300

# Minimum and maximum seconds between bot teleports to new areas or zones
# Defaults: 3600 (min), 18000 (max)
Playerbots.MinRandomBotTeleportInterval = 3600
Playerbots.MaxRandomBotTeleportInterval = 18000

# Number of seconds bots flagged as permanent stay in the world (31,104,000 ≈ 1 year)
# Default: 31104000
Playerbots.PermanentlyInWorldTime = 31104000

